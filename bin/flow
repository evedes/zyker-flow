#!/bin/sh
# shellcheck disable=SC3013 # test -nt: POSIX since 2024, and in every sh this runs under.
# flow launcher: runs the flow binary with this script's arguments and stdin.
# The first of these that applies is run:
#
#   1. $FLOW_BIN (an absolute path).
#   2. <root>/target/release/flow, a build of this checkout. It is rebuilt with cargo
#      first when anything under src/ or templates/, Cargo.toml or Cargo.lock is newer.
#   3. The release binary of VERSION for this platform, cached in
#      ${FLOW_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/flow}/<VERSION>/<target>/flow
#      and downloaded from the v<VERSION> GitHub release when missing. It must match
#      the SHA256SUMS committed next to VERSION, run here, and have been built from
#      this checkout's sources (the `source` line there). A stamp in target/ naming
#      the verified binary skips these checks until VERSION, SHA256SUMS or a source
#      changes.
#   4. A build from source with cargo (step 2 from then on). Without cargo, a release
#      built from other sources runs, with a warning.
#
# Failing that, it fails closed: in a repo with a .flow.json at its git root,
# `hook pre-tool-use` denies the call and `hook session-start` says why; the CLI exits
# with status 1. A hook outside a flow repo prints nothing and never downloads or
# builds. In hook mode only the binary's output reaches stdout, and the binary runs as
# a child rather than with exec, so that one the shell cannot execute (exit 126 or 127)
# is denied too.
# With a verified binary, a call costs at most one `uname`: this runs on every tool call.

# zsh: POSIX globbing (an empty directory is not an error) and word splitting.
[ -z "${ZSH_VERSION:-}" ] || emulate sh

REPO=https://github.com/evedes/zyker-flow

self=$0
case $self in /*) ;; *) self=$PWD/$self ;; esac
while [ -h "$self" ]; do
	link=$(readlink "$self") || break
	case $link in /*) self=$link ;; *) self=${self%/*}/$link ;; esac
done
case $self in
*/./* | */../* | *//*) d=$(cd -P "${self%/*}" && pwd -P) && self=$d/${self##*/} ;;
esac
FLOW_SELF=$self
export FLOW_SELF
root=${self%/*/*}

hook=
[ "${1:-}" = hook ] && [ $# -ge 2 ] && hook=$2

dev=$root/target/release/flow
[ -x "$dev.exe" ] && dev=$dev.exe
stamp=$root/target/.flow-release
cached=
why=

# --- helpers ---------------------------------------------------------------------

note() { printf 'flow: %s\n' "$*" >&2; }

# because REASON: adds REASON to $why, the explanation for having no binary.
because() { why=${why:+$why; }$*; }

# A relative directory from the environment would resolve inside the guarded repo.
absolute() { case $1 in /*) return 0 ;; *) return 1 ;; esac; }

# newer TARGET PATH...: is a PATH, or a file under it, newer than TARGET?
newer() {
	t=$1
	shift
	for f; do
		if [ -d "$f" ]; then
			newer "$t" "$f"/* && return 0
		elif [ "$f" -nt "$t" ]; then
			return 0
		fi
	done
	return 1
}

# stale TARGET [PATH...]: is a source cargo builds from, or a PATH, newer than TARGET?
stale() {
	t=$1
	shift
	newer "$t" "$root/src" "$root/templates" "$root/Cargo.toml" "$root/Cargo.lock" "$@"
}

# run BIN ARGS...: runs the binary and exits with its status. A hook runs it as a
# child, so that a binary the shell cannot execute fails closed (and a cached one is
# dropped, to be downloaded and verified again).
run() {
	[ -n "$hook" ] || exec "$@"
	"$@"
	rc=$?
	[ $rc -eq 126 ] || [ $rc -eq 127 ] || exit $rc
	what=$1
	[ "$1" = "${FLOW_BIN:-}" ] && what="FLOW_BIN=$1"
	[ "$1" = "$cached" ] && rm -f "$cached" "$stamp"
	fail "$what cannot be executed (exit $rc)"
}

# Is the git root of the working directory a flow repo?
in_flow_repo() {
	if command -v git >/dev/null 2>&1; then
		top=$(git rev-parse --show-toplevel </dev/null 2>/dev/null) || return 1
	else
		top=$PWD
		until [ -e "$top/.git" ]; do
			[ -n "$top" ] || return 1
			top=${top%/*}
		done
	fi
	[ -f "$top/.flow.json" ]
}

# fail WHY: there is no binary to run; fails closed as the mode requires.
fail() {
	[ -z "$hook" ] || cat >/dev/null 2>&1
	case $hook in
	'')
		note "no flow binary: $1"
		exit 1
		;;
	pre-tool-use)
		in_flow_repo || exit 0
		json "flow: hook error: no flow binary: $1"
		printf '{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": "%s"}}\n' "$json"
		;;
	session-start)
		in_flow_repo || exit 0
		json "flow: no flow binary ($1), so the flow hook denies every Edit, Write, MultiEdit, NotebookEdit and Bash call in this repo. Tell the user: the plugin's bin/flow needs network access to download its release binary, cargo to build it, or FLOW_BIN set to one."
		printf '{"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "%s"}}\n' "$json"
		;;
	esac
	exit 0
}

# json STRING: sets $json to STRING as the inside of a JSON string (control characters
# become spaces).
json() {
	json=$(printf '%s' "$1" | tr '\n' ' ' | LC_ALL=C sed 's/[[:cntrl:]]/ /g; s/[\\"]/\\&/g')
}

have_cargo() {
	cargo=$(command -v cargo) || cargo=${CARGO_HOME:-${HOME:-}/.cargo}/bin/cargo
	[ -x "$cargo" ]
}

# build: cargo builds the plugin into <root>/target, its output on stderr. The build
# gets the time it started, so that a source saved meanwhile is built next time.
build() {
	have_cargo || { because "no cargo to build it from source" && return 1; }
	marker=$root/target/.flow-build.$$
	mkdir -p "$root/target" && touch "$marker"
	if ! "$cargo" build --release --locked --quiet --manifest-path "$root/Cargo.toml" \
		--target-dir "$root/target" </dev/null >&2; then
		rm -f "$marker"
		because "cargo build --release failed in $root"
		return 1
	fi
	[ -x "$root/target/release/flow.exe" ] && dev=$root/target/release/flow.exe
	touch -r "$marker" "$dev" 2>/dev/null || touch "$dev"
	rm -f "$marker"
	[ -x "$dev" ] || { because "cargo build left no $dev" && return 1; }
}

sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$@"
	else
		shasum -a 256 "$@"
	fi
}

# pinned NAME: prints NAME's hash in the committed SHA256SUMS.
pinned() {
	[ -r "$root/SHA256SUMS" ] || return 1
	while read -r h n || [ -n "$h" ]; do
		[ "${n#\*}" = "$1" ] && echo "$h" && return 0
	done <"$root/SHA256SUMS"
	return 1
}

# The hash of this checkout's sources: the SHA-256 of `sha256sum` over them, sorted
# by path (scripts/source-hash prints the same).
source_hash() {
	(cd "$root" && find src templates Cargo.toml Cargo.lock -type f 2>/dev/null |
		LC_ALL=C sort | while IFS= read -r f; do sha256 "$f"; done) |
		sha256 | { read -r h _ && echo "$h"; }
}

# own_sources: was the pinned release built from this checkout's sources?
own_sources() {
	[ -f "$root/Cargo.toml" ] || return 0
	want=$(pinned source) && [ "$(source_hash)" = "$want" ] && return 0
	because "v$ver was released from other sources than $root"
	return 1
}

# verify FILE: is FILE the pinned binary $name, and does it run here? Sets $err if not.
verify() {
	sum=$(sha256 <"$1") || { err="cannot hash $1" && return 1; }
	sum=${sum%% *}
	[ "$sum" = "$pin" ] || { err="checksum mismatch for $name v$ver (got $sum, want $pin)" && return 1; }
	chmod 755 "$1" 2>/dev/null
	"$1" </dev/null >/dev/null 2>&1 || { err="$name v$ver does not run here (exit $?)" && return 1; }
}

# fetch URL FILE: one attempt in bounded time, its output on stderr. Sets $err.
fetch() {
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL --connect-timeout 10 --max-time 60 -o "$2" "$1" </dev/null >&2 ||
			{ err="downloading $1 failed (curl exit $?)" && return 1; }
	elif command -v wget >/dev/null 2>&1; then
		wget -q -T 15 -t 1 -O "$2" "$1" </dev/null >&2 ||
			{ err="downloading $1 failed (wget exit $?)" && return 1; }
	else
		err="no curl or wget to download $1"
		return 1
	fi
}

# Did a download fail in the last five minutes? Sets $msg to why it did.
failed_recently() {
	[ -f "$failed" ] && read -r t msg <"$failed" && now=$(date +%s) || return 1
	case $t in '' | *[!0-9]*) return 1 ;; esac
	[ "$t" -le "$now" ] && [ $((now - t)) -lt 300 ]
}

# download: fetches the release binary and installs it as $cached once verified. A
# failure is remembered for five minutes, so an offline machine does not wait on
# every call.
download() {
	dir=${cached%/*}
	failed=$dir/.failed
	if failed_recently; then
		because "$msg (not retried for 5 minutes)"
		return 1
	fi
	if ! { mkdir -p "$dir" && tmp=$(mktemp "$dir/.download.XXXXXX"); }; then
		because "cannot create a temporary file in $dir"
		return 1
	fi
	if ! fetch "$REPO/releases/download/v$ver/$name" "$tmp"; then
		rm -f "$tmp"
		printf '%s %s\n' "$(date +%s)" "$err" >"$failed" 2>/dev/null
		because "$err"
		return 1
	fi
	verify "$tmp" || { rm -f "$tmp" && because "$err" && return 1; }
	# rename(2) within a directory: a concurrent launcher sees the old file or the new.
	mv -f "$tmp" "$cached" || { rm -f "$tmp" && because "cannot install $cached" && return 1; }
	rm -f "$failed"
}

# release: the pinned release binary, verified (downloaded if need be), as $cached.
release() {
	if [ -x "$cached" ] && verify "$cached"; then
		return 0
	fi
	download
}

# --- 1 and 2: FLOW_BIN and the dev build -------------------------------------------

if [ -n "${FLOW_BIN:-}" ]; then
	absolute "$FLOW_BIN" || fail "FLOW_BIN=$FLOW_BIN is not an absolute path"
	[ -f "$FLOW_BIN" ] && [ -x "$FLOW_BIN" ] && run "$FLOW_BIN" "$@"
	fail "FLOW_BIN=$FLOW_BIN is not an executable file"
fi

if [ -x "$dev" ]; then
	# A hook outside a flow repo does nothing, so there the previous build will do.
	if stale "$dev" && { [ -z "$hook" ] || in_flow_repo; }; then
		build || note "$why; running the previous build"
	fi
	run "$dev" "$@"
fi

# --- 3: the release binary -----------------------------------------------------------

ver=
[ -r "$root/VERSION" ] && read -r ver <"$root/VERSION"
if absolute "${FLOW_CACHE_DIR:-}"; then
	cache=$FLOW_CACHE_DIR
elif absolute "${XDG_CACHE_HOME:-}"; then
	cache=$XDG_CACHE_HOME/flow
elif absolute "${HOME:-}"; then
	cache=$HOME/.cache/flow
else
	cache=
fi
platform=$(uname -s -m 2>/dev/null)
case $platform in
'Linux x86_64' | 'Linux amd64') triple=x86_64-unknown-linux-musl ;;
'Linux aarch64' | 'Linux arm64') triple=aarch64-unknown-linux-musl ;;
'Darwin x86_64') triple=x86_64-apple-darwin ;;
'Darwin arm64' | 'Darwin aarch64') triple=aarch64-apple-darwin ;;
*) triple= ;;
esac
cached=$cache/$ver/$triple/flow

verified=
[ -f "$stamp" ] && read -r verified <"$stamp"
if [ "$verified" = "$cached" ] && [ -x "$cached" ] && ! [ "$cached" -nt "$stamp" ] &&
	! stale "$stamp" "$root/VERSION" "$root/SHA256SUMS"; then
	run "$cached" "$@"
fi

# --- nothing verified to run -----------------------------------------------------------

# A hook outside a flow repo does nothing, so it does not download or build either.
[ -z "$hook" ] || in_flow_repo || { cat >/dev/null 2>&1; exit 0; }

# $name is set once there is a pinned release binary to run.
name=
if [ -z "$ver" ]; then
	because "no VERSION file in $root"
elif [ -z "$cache" ]; then
	because "no cache directory (HOME is not set or not absolute)"
elif [ -z "$triple" ]; then
	because "no release binary for ${platform:-this platform}"
elif ! pin=$(pinned "flow-$triple"); then
	because "no checksum for flow-$triple v$ver in $root/SHA256SUMS"
elif ! command -v sha256sum >/dev/null 2>&1 && ! command -v shasum >/dev/null 2>&1; then
	because "no sha256sum or shasum to verify the release binary"
else
	name=flow-$triple
fi

own=
if [ -n "$name" ] && own_sources; then
	own=1
	if release; then
		{ mkdir -p "${stamp%/*}" && printf '%s\n' "$cached" >"$stamp"; } 2>/dev/null
		run "$cached" "$@"
	fi
fi

if [ -f "$root/Cargo.toml" ]; then
	if have_cargo; then
		note "$why; building it from source"
		build && run "$dev" "$@"
	else
		because "no cargo to build it from source"
	fi
fi

# A release from other sources, as the last resort.
if [ -n "$name" ] && [ -z "$own" ] && release; then
	note "warning: $why; running the release"
	run "$cached" "$@"
fi

fail "$why"
