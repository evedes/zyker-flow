#!/bin/sh
# Smoke-tests flow against the real repos that use it: runs this checkout's bin/flow (or
# --flow PATH) in every repo with a .flow.json in ~/Work (or in the repos given), with
# `flow status`, the session-start hook and the pre-tool-use hook on a fixed set of tool
# calls whose verdict follows from that repo's .flow.json and state. Nothing is
# written. The checks are tests/smoke.rs's `real_repos`, run through cargo.
#
# Usage: scripts/smoke [--flow PATH] [REPO ...]
set -eu
usage() {
	echo "usage: scripts/smoke [--flow PATH] [REPO ...]" >&2
	exit 2
}
# The absolute form of a path (symlinks resolved when it exists).
absolute() {
	if [ -d "$1" ]; then
		(cd -P "$1" && pwd -P)
	elif [ -d "$(dirname "$1")" ]; then
		echo "$(cd -P "$(dirname "$1")" && pwd -P)/$(basename "$1")"
	else
		case $1 in /*) echo "$1" ;; *) echo "$PWD/$1" ;; esac
	fi
}
if [ "${1:-}" = --flow ]; then
	[ $# -ge 2 ] || usage
	FLOW_SMOKE_BIN=$(absolute "$2")
	export FLOW_SMOKE_BIN
	shift 2
fi
repos=
for r in "$@"; do
	repos="$repos $(absolute "$r")"
done
FLOW_SMOKE_REPOS=${repos# }
export FLOW_SMOKE_REPOS
cd "$(dirname "$0")/.."
exec cargo test --release --quiet --test smoke -- --ignored --nocapture real_repos
